# Server Port & Environment
PORT=5000
NODE_ENV=development

# Database File Path (SQLite)
DATABASE_PATH=./data/resolveai.db

# JWT Secret and Expiration (Change for production)
JWT_SECRET=resolveai_super_secret_jwt_signing_key_replace_in_production
JWT_EXPIRES_IN=24h

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# Google Gemini API Key (Optional: system operates with graceful fallback if omitted)
# Get a key from https://aistudio.google.com/
GEMINI_API_KEY=

# First-Response SLA Window in calendar hours (Default: 4 hours)
SLA_HOURS=4

# Cookie Secure Flag (Set to true in HTTPS production environments)
COOKIE_SECURE=false
